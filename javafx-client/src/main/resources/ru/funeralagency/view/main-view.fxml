<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.funeralagency.controller.MainController"
            styleClass="app-root" prefWidth="1240" prefHeight="760">
    <top>
        <VBox spacing="18" styleClass="page-header">
            <Label text="Заявки на организацию ритуала" styleClass="page-title" wrapText="true"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Добавить" onAction="#handleAdd" styleClass="button-primary"/>
                <Button text="Изменить" onAction="#handleEdit"/>
                <Button text="Удалить" onAction="#handleDelete" styleClass="button-danger"/>
                <Button text="Обновить" onAction="#handleRefresh"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Статистика" onAction="#handleStatistics"/>
                <Button text="Экспорт в Excel" onAction="#handleExport"/>
            </HBox>

            <VBox spacing="16" styleClass="surface">
                <FlowPane hgap="16" vgap="12">
                    <VBox spacing="6">
                        <Label text="Дата церемонии" styleClass="field-label"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <DatePicker fx:id="dateFromFilterPicker" editable="false"
                                        promptText="Дата от" prefWidth="148"/>
                            <Label text="—" styleClass="muted-label"/>
                            <DatePicker fx:id="dateToFilterPicker" editable="false"
                                        promptText="Дата до" prefWidth="148"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Статус" styleClass="field-label"/>
                        <ComboBox fx:id="statusFilterComboBox" promptText="Все" prefWidth="174"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Тип церемонии" styleClass="field-label"/>
                        <ComboBox fx:id="ceremonyTypeFilterComboBox" promptText="Все" prefWidth="160"/>
                    </VBox>
                    <VBox spacing="6">
                        <Region prefHeight="16"/>
                        <Button text="Сбросить фильтры" onAction="#handleResetFilters"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="searchTypeComboBox" prefWidth="190" onAction="#handleSearchTypeChange"/>
                    <TextField fx:id="deceasedSearchField" promptText="Часть ФИО умершего"
                               prefWidth="360" minWidth="180" maxWidth="Infinity"
                               HBox.hgrow="ALWAYS" onAction="#handleSearch"/>
                    <ComboBox fx:id="clientSearchComboBox" promptText="Выберите клиента"
                              prefWidth="360" minWidth="180" maxWidth="Infinity"
                              HBox.hgrow="ALWAYS" visible="false" managed="false"/>
                    <Button text="Найти" onAction="#handleSearch" styleClass="button-primary"/>
                    <Button text="Сбросить" onAction="#handleResetSearch"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="requestsTable">
            <BorderPane.margin>
                <Insets top="0" right="24" bottom="24" left="24"/>
            </BorderPane.margin>
            <placeholder>
                <Label text="Заявки не найдены" styleClass="muted-label"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                <TableColumn fx:id="clientNameColumn" text="Клиент" prefWidth="230"/>
                <TableColumn fx:id="deceasedNameColumn" text="ФИО умершего" prefWidth="240"/>
                <TableColumn fx:id="ceremonyDateColumn" text="Дата церемонии" prefWidth="150"/>
                <TableColumn fx:id="ceremonyTypeTableColumn" text="Тип церемонии" prefWidth="150"/>
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="150"/>
                <TableColumn fx:id="priceColumn" text="Стоимость" prefWidth="145"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
